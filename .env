# ═══════════════════════════════════════════════════════════════
# DiaBienEtre .env — Configuration Supabase + Vercel
# ═══════════════════════════════════════════════════════════════

# ───── NextAuth (Auth admin) ──────────────────────────────────
# IMPORTANT: Génère une nouvelle clé pour production: openssl rand -base64 32
NEXTAUTH_SECRET=changez-moi-avec-openssl-rand-base64-32
# URL publique du site (localhost en dev, ton domaine Vercel en prod)
NEXTAUTH_URL=http://localhost:3000

# ───── Admin par défaut ───────────────────────────────────────
ADMIN_EMAIL=admin@diabienetre.sn
ADMIN_PASSWORD=admin2024

# ═════════════════════════════════════════════════════════════════
# SUPABASE — Base de données PostgreSQL
# ═════════════════════════════════════════════════════════════════
# Connection poolée (pgBouncer, port 6543) — utilise pour l'app
DATABASE_URL="postgresql://postgres.owijildlylcwarsactdm:diabienetre01234@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Connection directe (port 5432) — utilise UNIQUEMENT pour les migrations Prisma
# IMPORTANT: hôte direct db.[ref].supabase.co — pas le pooler
DIRECT_URL="postgresql://postgres.owijildlylcwarsactdm:diabienetre01234@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ═════════════════════════════════════════════════════════════════
